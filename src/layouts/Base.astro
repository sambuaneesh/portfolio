---
import '../styles/global.css';
import '../styles/punk.css';
import '../styles/themes.css';
import { WORKSPACES, BUILD, u, fmtDate, type WorkspaceKey } from '../lib/site';
import { getPersonalInfo, getModules, getSiteSettings, THEMES } from '../lib/db';
import { isFallback } from '../lib/snapshot';

interface Props {
  title?: string;
  description?: string;
  ws?: WorkspaceKey | null;
  noindex?: boolean;
  image?: string;
  prevHref?: string;
  nextHref?: string;
  /** Short name for this page in the reading trail. */
  crumb?: string;
  /** The page's LCP image, fetched from the <head> at top priority. */
  preloadImage?: string;
}

const { title, description, ws = null, noindex = false, image, prevHref, nextHref, crumb, preloadImage } = Astro.props;
const [me, modules, settings] = await Promise.all([getPersonalInfo(), getModules(), getSiteSettings()]);

// One cover colour for everyone, picked in /admin and baked in at build.
const wanted = settings.theme === 'riso-blue' ? 'riso' : settings.theme; // retired name
// 'random' is resolved in the browser (before first paint); the HTML ships trash.
const randomTheme = wanted === 'random';
const theme = (THEMES as readonly string[]).includes(wanted) ? wanted : 'trash';

const fullTitle = title ? `${title} · ${me.name}` : `${me.name} · ${me.title}`;
const desc = description ?? me.bio.split('. ').slice(0, 2).join('. ').replace(/\.?$/, '.');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ?? me.avatar_url ?? undefined;

// Everything the `:` command line can do, baked into the page as JSON.
const commands = [
  ...WORKSPACES.map((w) => ({ l: `go ${w.label}`, h: `${w.n}`, u: u(w.href) })),
  ...modules.map((m) => ({ l: `open ${m.title}`, h: m.part, u: u(`/projects/${m.slug}/`) })),
  { l: 'download resume.pdf', h: 'pdf', u: u('/resume.pdf') },
  me.github && { l: 'github', h: 'ext', u: me.github },
  me.linkedin && { l: 'linkedin', h: 'ext', u: me.linkedin },
  me.email && { l: `mail ${me.email}`, h: 'ext', u: `mailto:${me.email}` },
  me.website && { l: 'blog (the boring blog)', h: 'ext', u: me.website },
  me.instagram && { l: 'instagram', h: 'ext', u: me.instagram },
  ...(settings.extra_links ?? []).map((l) => ({ l: l.label, h: 'ext', u: l.url })),
  { l: 'print cv', h: 'cv', u: `${u('/cv/')}#print` },
  { l: 'help', h: '?', a: 'help' },
].filter(Boolean);

const sameAs = [me.github, me.linkedin, me.website, me.twitter, me.medium, me.instagram, me.youtube, me.codeforces, ...(settings.extra_links ?? []).map((l) => l.url)].filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: me.name,
  jobTitle: me.title,
  description: me.bio,
  url: new URL(u('/'), Astro.site).href,
  image: me.avatar_url,
  email: me.email ? `mailto:${me.email}` : undefined,
  sameAs,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'International Institute of Information Technology, Hyderabad' },
};
---
<!doctype html>
<html lang="en" data-theme={theme} data-punk={settings.zine_punk !== false ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" id="vp" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Phones get the full desktop zine, zoomed out, unless /admin says reflow. -->
    <script is:inline define:vars={{ mobileLayout: settings.mobile_layout }}>
      if (mobileLayout === 'desktop' && Math.min(screen.width, screen.height) < 900) {
        document.getElementById('vp').setAttribute('content', 'width=1280, viewport-fit=cover');
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={me.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#2a2926" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {prevHref && <link rel="prev" href={prevHref} />}
    {nextHref && <link rel="next" href={nextHref} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />

    <!-- Which edition to print, decided before first paint (no flash):
         1. admin preview (?preview=, ?punk=): signed-in admin or localhost only
         2. ?edition=acid in the URL (shareable), or an edition picked from
            the cover sticker: held while turning pages, dropped on refresh
         3. random mode (set in /admin): a new roll per visit and per refresh,
            but stable while turning pages
         4. otherwise the edition baked into the HTML -->
    <script is:inline define:vars={{ themes: [...THEMES], randomTheme }}>
      (function () {
        var d = document.documentElement;
        var q = new URLSearchParams(location.search);
        var t = q.get('preview'), punk = q.get('punk');
        if ((t && themes.indexOf(t) >= 0) || punk !== null) {
          var admin = false;
          try { admin = !!localStorage.getItem('admin_token'); } catch (e) {}
          if (admin || /^(localhost|127\.|\[::1\])/.test(location.hostname)) {
            if (t && themes.indexOf(t) >= 0) { d.dataset.theme = t; d.dataset.preview = t; }
            if (punk === '0') delete d.dataset.punk;
            if (punk === '1') d.dataset.punk = '';
            if (punk !== null) d.dataset.previewPunk = punk;
            if (t && themes.indexOf(t) >= 0) return;
          }
        }
        // A pick (sticker or ?edition= link) holds while turning pages; a
        // refresh or a fresh visit drops it and rolls again.
        var nav = performance.getEntriesByType ? performance.getEntriesByType('navigation')[0] : null;
        // "fresh" = a refresh, or a new tab/session (nothing rolled yet).
        // Deliberately not based on document.referrer: privacy-hardened
        // browsers blank it, which made every page turn look fresh.
        var seen = null;
        try { seen = sessionStorage.getItem('zine-seen'); sessionStorage.setItem('zine-seen', '1'); } catch (e) {}
        var fresh = (nav && nav.type === 'reload') || !seen;
        var shared = q.get('edition');
        var pin = null;
        try {
          try { localStorage.removeItem('zine-edition'); } catch (e) {} // older builds kept picks forever
          if (shared && themes.indexOf(shared) >= 0) sessionStorage.setItem('zine-pin', shared);
          else if (fresh) sessionStorage.removeItem('zine-pin');
          pin = sessionStorage.getItem('zine-pin');
        } catch (e) { pin = shared; }
        if (pin && themes.indexOf(pin) >= 0) { d.dataset.theme = pin; return; }
        if (!randomTheme) return;
        var cur = null;
        try { cur = sessionStorage.getItem('zine-roll'); } catch (e) {}
        if (fresh || themes.indexOf(cur) < 0) {
          var others = themes.filter(function (x) { return x !== cur; });
          cur = others[Math.floor(Math.random() * others.length)];
          try { sessionStorage.setItem('zine-roll', cur); } catch (e) {}
        }
        d.dataset.theme = cur;
        d.dataset.random = '';
      })();
    </script>
    <!-- Chromium prerenders same-site links on hover: page turns feel instant. -->
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      // the obvious next pages (next/prev, sections) are fetched as soon as
      // this one has loaded; anything else is prerendered on hover/press
      prefetch: [{ where: { selector_matches: '.next, .prev, .ws, .dock a, .trail a' }, eagerness: 'eager' }],
      prerender: [{ where: { and: [{ href_matches: `${u('/')}*` }, { not: { href_matches: `${u('/admin/')}*` } }] }, eagerness: 'moderate' }],
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="bar">
      <a class="bar__brand" href={u('/')}><b>#{settings.zine_issue}</b>{settings.zine_title.toLowerCase()}</a>
      <nav class="bar__nav" aria-label="Sections">
        {WORKSPACES.map((w) => (
          <a class="ws" href={u(w.href)} aria-current={ws === w.key ? 'page' : undefined} data-ws={w.n}>
            <span class="ws__n">{w.n}</span><span>{w.label}</span>
          </a>
        ))}
      </nav>
      <div class="bar__right">
        <span class="clock" data-clock title="Local time in Hyderabad">HYD --:--</span>
        <button class="chip" type="button" data-cmd-open title="Command line"><kbd>:</kbd><span>cmd</span></button>
        <button class="chip chip--help" type="button" data-help-open title="Keyboard shortcuts"><kbd>?</kbd><span class="sr-only"> help</span></button>
      </div>
    </header>

    <nav class="trail" data-trail aria-label="Reading trail" hidden></nav>

    <main id="main" class="zine" tabindex="-1" data-crumb={crumb ?? title ?? 'cover'}>
      <slot />
    </main>

    <footer class="statusline">
      <span data-mode>{settings.footer_text} · printed {fmtDate(BUILD.at)}{isFallback() && <sup class="fallback" title="Built from the archived snapshot: a live source (database, GitHub or Steam) was unreachable at build time.">†</sup>}</span>
      <a href={settings.footer_github_url}>src@{BUILD.commit}</a>
      <span class="no-print">← → turn pages · <kbd class="k">:</kbd> commands</span>
    </footer>

    <nav class="dock" aria-label="Sections">
      {WORKSPACES.map((w) => (
        <a href={u(w.href)} aria-current={ws === w.key ? 'page' : undefined}><span>{w.n}</span><span>{w.label}</span></a>
      ))}
    </nav>

    <dialog id="cmd" aria-label="Command line">
      <div class="cmd__in"><span aria-hidden="true">:</span><input id="cmd-q" type="text" autocomplete="off" spellcheck="false" placeholder="go to a page or project" aria-controls="cmd-list" role="combobox" aria-expanded="true" /></div>
      <ul id="cmd-list" class="cmd__list" role="listbox"></ul>
      <div class="cmd__foot">↑↓ select · ↵ run · esc close</div>
    </dialog>

    <dialog id="help" aria-label="Keyboard shortcuts">
      <div class="win__bar"><span class="win__title">keyboard</span></div>
      <dl class="keys">
        <dt><kbd class="k">←</kbd> <kbd class="k">→</kbd></dt><dd>turn the page</dd>
        <dt><kbd class="k">1</kbd>–<kbd class="k">5</kbd></dt><dd>jump to a section</dd>
        <dt><kbd class="k">:</kbd> / <kbd class="k">ctrl</kbd><kbd class="k">k</kbd></dt><dd>command line</dd>
        <dt><kbd class="k">?</kbd></dt><dd>this help</dd>
        <dt><kbd class="k">esc</kbd></dt><dd>close</dd>
      </dl>
    </dialog>

    <script type="application/json" id="cmd-data" set:html={JSON.stringify(commands)} />
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: `${u('/sw.js')}?v=${BUILD.at.getTime()}`, scope: u('/'), list: u('/zine-pages.json') }}>
        if ('serviceWorker' in navigator && !location.pathname.includes('/admin/')) {
          addEventListener('load', function () {
            navigator.serviceWorker.register(sw, { scope: scope }).then(function () {
              return navigator.serviceWorker.ready;
            }).then(function (reg) {
              // precache the rest of the zine when idle, unless the visitor saves data
              var c = navigator.connection || {};
              if (c.saveData || /(^|-)2g$/.test(c.effectiveType || '')) return;
              (window.requestIdleCallback || setTimeout)(function () {
                fetch(list).then(function (r) { return r.json(); }).then(function (urls) {
                  (reg.active || navigator.serviceWorker.controller).postMessage({ type: 'precache', urls: urls });
                }).catch(function () {});
              }, { timeout: 4000 });
            }).catch(function () {});
          });
        }
      </script>
    )}
    <script>
      import '../scripts/shell';
    </script>
  </body>
</html>
