---
// One tiled window: a label-tape title bar + body. `href` turns the whole
// tile into a click target (the title link is stretched over it) while
// keeping only one real link in the tab order.
interface Props {
  title: string;
  meta?: string;
  href?: string;
  class?: string;
  id?: string;
  as?: 'section' | 'article' | 'aside' | 'div';
  vt?: string;
  ctl?: boolean;
}
const { title, meta, href, class: cls = '', id, as: Tag = 'section', vt, ctl = true } = Astro.props;
const hid = id ? `${id}-t` : undefined;
---
<Tag class:list={['win', cls]} id={id} data-tile aria-labelledby={hid} style={vt ? `view-transition-name:${vt}` : undefined}>
  <div class="win__bar">
    {href
      ? <a class="win__title stretch" id={hid} href={href} data-primary>{title}</a>
      : <span class="win__title" id={hid}>{title}</span>}
    {meta && <span class="win__meta">{meta}</span>}
    {ctl && <span class="win__ctl" aria-hidden="true"><i></i><i></i><i></i></span>}
  </div>
  <div class="win__body">
    <slot />
  </div>
  {Astro.slots.has('foot') && <div class="win__foot lift"><slot name="foot" /></div>}
</Tag>
