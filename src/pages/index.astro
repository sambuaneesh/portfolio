---
import Base from '../layouts/Base.astro';
import Spread from '../components/Spread.astro';
import { getPersonalInfo, getModules, getExperience, getEducation, getAchievements, getSkills, getBlogPosts, getSiteSettings } from '../lib/db';
import { u } from '../lib/site';
import { glyph } from '../lib/glyphs';
import { optimize } from '../lib/images';
import { toolchain } from '../lib/toolchain';
import { getSteam, getSteamReviews } from '../lib/steam';
import { getMonkeytype } from '../lib/monkeytype';
import Scribble from '../components/Scribble.astro';
import Ransom from '../components/Ransom.astro';
import { pageMap, pad2, pg } from '../lib/zine';
import { code128Svg } from '../lib/code128';
import signatureUrl from '../assets/signature.svg?url';
import { BUILD } from '../lib/site';

const [me, modules, experience, education, achievements, skills, posts, settings] = await Promise.all([
  getPersonalInfo(), getModules(), getExperience(), getEducation(), getAchievements(), getSkills(), getBlogPosts(), getSiteSettings(),
]);

const P = pageMap(modules, posts.length);
const Z = settings.zine_title;
const featured = modules.filter((m) => m.featured).slice(0, 4);
const running = experience.filter((e) => /present/i.test(e.duration));
const now = running.length ? running : experience.slice(0, 1);
const last = experience.filter((e) => !/present/i.test(e.duration));
const chain = toolchain(skills.filter((s) => s.category === 'Languages'), modules);
const school = education[0];
const lab = settings.badge_lab;

const steamUrl = (settings.extra_links ?? []).find((l) => /steamcommunity\.com/.test(l.url))?.url;
const steam = steamUrl ? await getSteam(steamUrl) : null;
// only the games I'd recommend make it into the zine
const reviews = steamUrl ? (await getSteamReviews(steamUrl)).filter((r) => r.recommended).slice(0, 3) : [];
// Two lists for off hours: recently played (public feed, the default tab)
// and most played across the whole library (needs STEAM_API_KEY).
const withImg = <T extends { capsule: string }>(list: T[]) =>
  Promise.all(list.slice(0, 5).map(async (g) => ({ ...g, img: g.capsule ? await optimize(g.capsule, 184, 69) : null })));
const games = steam ? await withImg(steam.games) : [];
const topGames = steam ? await withImg(steam.top ?? []) : [];

const mtUrl = (settings.extra_links ?? []).find((l) => /monkeytype\.com\/profile\//.test(l.url))?.url;
const typing = mtUrl ? await getMonkeytype(mtUrl) : null;

const photo = me.avatar_url ? await optimize(me.avatar_url, 520, 620) : null;

// masthead: "The Boring Zine" -> boxed "THE BORING" over a huge "ZINE"
const words = Z.trim().split(/\s+/);
const mastBig = words.length > 1 ? words[words.length - 1] : Z;
const mastSmall = words.length > 1 ? words.slice(0, -1).join(' ') : '';
// cover line "the systems issue" -> small "the", big "systems", small "issue"
const iss = settings.zine_issue_theme.trim().split(/\s+/);
const issBig = iss.length >= 3 ? iss.slice(1, -1).join(' ') : iss.join(' ');
const issPre = iss.length >= 3 ? iss[0] : '';
const issPost = iss.length >= 3 ? iss[iss.length - 1] : '';

// the cover barcode is real Code 128: scan it and you get this text
const barcodeText = (settings.barcode || 'src@{commit}')
  .replace(/\{commit\}/g, BUILD.commit)
  .replace(/\{epoch\}/g, String(Math.floor(BUILD.at.getTime() / 1000)))
  .replace(/\{issue\}/g, settings.zine_issue)
  .replace(/[^\x20-\x7e]/g, '');
let barcodeSvg = '';
try { barcodeSvg = code128Svg(barcodeText || 'src', 40); } catch { barcodeSvg = code128Svg('src', 40); }

const printed = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' }).format(new Date());
const coverLines = [...featured.map((m) => m.title), achievements[0]?.title, '...and more'].filter(Boolean) as string[];

const editions = [
  { key: 'trash', sw: '#e4605b', blurb: 'the photocopy' },
  { key: 'blueprint', sw: '#1e4c98', blurb: 'drafting sheets' },
  { key: 'riso', sw: '#ff48b0', blurb: 'two inks' },
  { key: 'toner', sw: '#121212', blurb: 'copy of a copy' },
  { key: 'hotline', sw: '#ff2e88', blurb: 'vhs, 1989' },
  { key: 'acid', sw: '#d4f53c', blurb: 'rave flyer' },
];

const ports = [
  me.github && { k: 'GIT', v: me.github.replace(/^https?:\/\/(www\.)?/, ''), href: me.github },
  me.linkedin && { k: 'LNK', v: 'linkedin/aneesh-sambu', href: me.linkedin },
  me.email && { k: 'MAIL', v: me.email, href: `mailto:${me.email}` },
  me.website && { k: 'BLOG', v: me.website.replace(/^https?:\/\//, ''), href: me.website },
  me.instagram && { k: 'IG', v: `@${me.instagram.replace(/\/$/, '').split('/').pop()}`, href: me.instagram },
  me.twitter && { k: 'X', v: me.twitter.replace(/^https?:\/\/(www\.)?/, ''), href: me.twitter },
  me.medium && { k: 'MED', v: me.medium.replace(/^https?:\/\/(www\.)?/, ''), href: me.medium },
  me.youtube && { k: 'YT', v: me.youtube.replace(/^https?:\/\/(www\.)?/, ''), href: me.youtube },
  me.codeforces && { k: 'CF', v: me.codeforces.replace(/^https?:\/\/(www\.)?/, ''), href: me.codeforces },
  ...(settings.extra_links ?? []).map((l) => ({ k: l.label.slice(0, 5).toUpperCase(), v: l.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''), href: l.url })),
].filter(Boolean) as { k: string; v: string; href: string }[];
---
<Base ws="home" nextHref={u('/projects/')} preloadImage={photo?.src}>
  <h1 class="sr-only">{me.name}: {me.title}</h1>

  <!-- 01 · cover -->
  <Spread page={P.cover} single bare cover label="Cover">
    <div class="cover">
      <p class="spine" aria-hidden="true">issue #{settings.zine_issue} · {printed} · free</p>
      <div class="mast">
        {mastSmall && <span class="mast__small">{mastSmall}</span>}
        <span class="mast__big">{mastBig}</span>
        <span class="mast__tag">{settings.zine_tagline}</span>
      </div>
      <div class="cover__art">
        {photo && (
          <div class="cover__pinned">
            <figure class="halftone cover__photo">
              <img src={photo.src} width={photo.width} height={photo.height} alt={`Portrait of ${me.name}`} fetchpriority="high" decoding="async" />
            </figure>
            <svg class="pin punk-only cover__pin" viewBox="0 0 74 26" aria-hidden="true"><path d="M8 13h50a9 9 0 1 0-9-9" fill="none" stroke="#141414" stroke-width="2.2" stroke-linecap="round" /><path d="M8 13h46" fill="none" stroke="#d9d6cf" stroke-width="1" /><circle cx="8" cy="13" r="5" fill="#d9d6cf" stroke="#141414" stroke-width="2" /><path d="M56 13l12 0" stroke="#141414" stroke-width="2.4" stroke-linecap="round" /></svg>
    
          </div>
        )}
        <p class="issue-line" aria-hidden="true">{issPre && <small>{issPre}</small>}<b><Ransom text={issBig} /></b>{issPost && <small>{issPost}</small>}</p>
        <p class="burst-doodle" aria-hidden="true"><span class="note">click me! <span class="doodle-face">&gt;_&lt;</span></span><Scribble kind="arrow-down" /></p>
        <button class="burst cover__burst" type="button" popovertarget="editions" aria-label="Pick an edition"><span class="burst__name"></span><span class="burst__ed">edition</span></button>
      </div>
      <div class="cover__foot">
        <div class="barcode" title="Code 128: scan me"><span class="barcode__bars" set:html={barcodeSvg} /><small>{barcodeText}</small></div>
        <ul class="coverlines">
          {coverLines.map((l) => <li>{l}</li>)}
        </ul>
      </div>
      <p class="cover__open"><span class="note">psst.</span> <span class="ringed"><a href="#contents">open it</a><Scribble kind="ring" /></span></p>
    </div>
  </Spread>

  <!-- the easter egg: a torn scrap listing the editions -->
  <div id="editions" class="scrap" popover>
    <p class="note">pick an edition</p>
    <ul class="scrap__list">
      {editions.map((e) => (
        <li><button type="button" data-edition={e.key}><span class="scrap__sw" style={`--sw:${e.sw}`} aria-hidden="true"></span><b>{e.key}</b> <span class="muted">{e.blurb}</span></button></li>
      ))}
      <li><button type="button" data-edition="random"><span class="scrap__sw scrap__sw--rand" aria-hidden="true">?</span><b>surprise me</b> <span class="muted">new one every refresh</span></button></li>
    </ul>
    <div class="scrap__foot">
      <button class="scrap__close" type="button" data-share-edition>copy a link to this edition</button>
      <button class="scrap__close" type="button" popovertarget="editions" popovertargetaction="hide">close</button>
    </div>
  </div>

  <!-- 02-03 · contents | letter from the editor -->
  <Spread page={P.contents} zine={Z} runL="contents" runR="manifesto" id="contents" label="Contents and letter from the editor">
    <Fragment slot="left">
      <h2 class="hed hed--italic hed--l">Table of contents</h2>
      <div class="credits torn-bottom">
        <dl>
          <div><dt>editor-in-chief</dt><dd>{me.name}</dd></div>
          {lab && <div><dt>lab</dt><dd>{lab.url ? <a href={lab.url} rel="noopener">{lab.label}</a> : lab.label}</dd></div>}
          {school && <div><dt>unit</dt><dd>IIIT Hyderabad</dd></div>}
          {me.location && <div><dt>printed in</dt><dd>{me.location}</dd></div>}
          {settings.greetz?.length > 0 && <div><dt>greetz</dt><dd>{settings.greetz.join(' · ')}</dd></div>}
        </dl>
      </div>
      <p class="hint"><span class="note note--tilt">dotted = clickable. try it.</span><Scribble kind="arrow-down" /></p>
      <div class="toc-wrap">
        <section class="toc-group">
          <p class="toc__sec">manifesto <span class="note">← start here</span></p>
          <ul class="toc">
            <li><span class="toc__n">{pg(P.contents + 1)}</span><a href="#editor">Letter from the editor</a></li>
          </ul>
        </section>
        <section class="toc-group">
          <p class="toc__sec">this issue</p>
          <ul class="toc">
            <li><span class="toc__n">{pg(P.issue)}</span><a href="#issue">Featured projects</a></li>
            <li><span class="toc__n">{pg(P.issue + 1)}</span><a href="#research">Research &amp; awards</a></li>
            <li><span class="toc__n">{pg(P.offHours)}</span><a href="#offhours">Subsystems, off hours</a></li>
            <li><span class="toc__n">{pg(P.offHours + 1)}</span><a href="#classifieds">Classifieds</a></li>
          </ul>
        </section>
        <section class="toc-group">
          <p class="toc__sec">workbench</p>
          <ul class="toc">
            <li><span class="toc__n">{pg(P.workbench)}</span><a href={u('/projects/')}>The catalogue</a></li>
            {modules.filter((m) => !m.vibe).map((m) => (
              <li><span class="toc__n">{pg(P.projects[m.slug])}</span><a href={u(`/projects/${m.slug}/`)}>{m.title}</a></li>
            ))}
          </ul>
        </section>
        {P.supplement > 0 && (
          <section class="toc-group">
            <p class="toc__sec">vibe coded</p>
            <ul class="toc">
              <li><span class="toc__n">{pg(P.supplement)}</span><a href={u('/projects/vibe/')}>The supplement</a></li>
              {modules.filter((m) => m.vibe).map((m) => (
                <li><span class="toc__n">{pg(P.projects[m.slug])}</span><a href={u(`/projects/${m.slug}/`)}>{m.title}</a></li>
              ))}
            </ul>
          </section>
        )}
        <section class="toc-group">
          <p class="toc__sec">back of the book</p>
          <ul class="toc">
            <li><span class="toc__n">{pg(P.log)}</span><a href={u('/cv/')}>Field log (cv)</a></li>
            <li><span class="toc__n">{pg(P.writing)}</span><a href={u('/writing/')}>Writing</a></li>
            <li><span class="toc__n">{pg(P.contact)}</span><a href={u('/contact/')}>Write to me</a></li>
          </ul>
        </section>
      </div>
    </Fragment>

    <Fragment slot="right">
      <div class="letter" id="editor">
        <div class="letter__body">
          <p class="kicker">{me.location}</p>
          <h2 class="hed hed--thin hed--m"><span class="hl">{me.title}</span></h2>
          <p class="copy dropcap">{me.bio}</p>
          <div class="rulebox ps">
            <p class="lbl">ps aux</p>
            <ul>
              {now.map((e) => <li><span class="lbl">RUN</span> <b>{e.title}</b>, {e.company} <span class="muted">· {e.duration}</span></li>)}
              {last.map((e) => <li><span class="lbl lbl--line">EXIT 0</span> <b>{e.title}</b>, {e.company} <span class="muted">· {e.duration}</span></li>)}
            </ul>
          </div>
          <p class="sign"><span class="sr-only">— {me.name}</span><span class="sig" aria-hidden="true" style={`--sig:url(${signatureUrl})`} /></p>
        </div>
        <p class="letter__side" aria-hidden="true">letter from the editor</p>
      </div>
    </Fragment>
  </Spread>

  <!-- 04-05 · this issue | research -->
  <Spread page={P.issue} zine={Z} runL="this issue" runR="research" id="issue" label="Featured projects and research">
    <Fragment slot="left">
      <p class="kicker">workbench · featured</p>
      <h2 class="hed hed--xl hed--wide one-line"><span class="underlined">This issue<Scribble kind="underline" /></span></h2>
      <div class="feat">
        {featured.map((m) => (
          <article class="feat__item">
            <p class="feat__meta"><span class="lbl">{m.part}</span> <span class="mono muted">{m.language}</span><span class="mono turn">→ p. {pg(P.projects[m.slug])}</span></p>
            <h3 class="hed hed--m hed--cond"><a href={u(`/projects/${m.slug}/`)}>{m.title}</a></h3>
            <p class="copy">{m.description}</p>
          </article>
        ))}
      </div>
    </Fragment>
    <Fragment slot="right">
      <div id="research" class="stack">
        <h2 class="hed hed--l hed--outline">Research &amp;<br />awards</h2>
        <ol class="awards">
          {achievements.map((a, i) => (
            <li>
              <span class="lbl">{pad2(i + 1)}</span>
              <div>
                <h3 class="hed hed--s">{a.certificate_url ? <a href={a.certificate_url} rel="noopener">{a.title}</a> : a.title}{i === 0 && <> <Scribble kind="star" /><span class="note">the big one</span></>}</h3>
                {a.description && <p class="copy">{a.description}</p>}
              </div>
            </li>
          ))}
        </ol>
        {typing && typing.best.length > 0 && (
          <article class="slip taped taped--top" aria-label={`Monkeytype: ${typing.best[0].wpm} words per minute`}>
            <div class="slip__top">
              <p class="slip__form mono">form 0x9E · no. {typing.tests} · via monkeytype.com</p>
              <p class="stamp slip__stamp">typing citation</p>
            </div>
            <div class="slip__body">
              <svg class="gauge" viewBox="0 0 120 72" aria-hidden="true">
                <path class="gauge__arc" d="M10 64 A50 50 0 0 1 110 64" />
                <path class="gauge__red" d={`M${60 + 50 * Math.cos(Math.PI * (1 - 140 / 200))} ${64 - 50 * Math.sin(Math.PI * (1 - 140 / 200))} A50 50 0 0 1 110 64`} />
                {Array.from({ length: 11 }, (_, i) => {
                  const a = Math.PI * (1 - i / 10);
                  return <line class="gauge__tick" x1={60 + 44 * Math.cos(a)} y1={64 - 44 * Math.sin(a)} x2={60 + 50 * Math.cos(a)} y2={64 - 50 * Math.sin(a)} />;
                })}
                <line class="gauge__needle" x1="60" y1="64" x2={60 + 47 * Math.cos(Math.PI * (1 - Math.min(typing.best[0].wpm, 200) / 200))} y2={64 - 47 * Math.sin(Math.PI * (1 - Math.min(typing.best[0].wpm, 200) / 200))} />
                <circle class="gauge__hub" cx="60" cy="64" r="3.5" />
                <text class="gauge__unit" x="60" y="40" text-anchor="middle">wpm</text>
              </svg>
              <dl class="slip__rows">
                <div><dt>offender</dt><dd><a href={typing.url} rel="noopener">{typing.name}</a></dd></div>
                <div><dt>clocked at</dt><dd>{typing.best[0].wpm} wpm, {typing.best[0].acc}% ({typing.best[0].label})</dd></div>
                {typing.best.length > 1 && <div><dt>also</dt><dd>{typing.best.slice(1).map((b) => `${b.wpm} (${b.label})`).join(', ')}</dd></div>}
                <div><dt>priors</dt><dd>{typing.tests.toLocaleString('en-US')} tests, {typing.hours} h</dd></div>
                {typing.rank && <div><dt>standing</dt><dd>top {typing.rank.pct}%</dd></div>}
              </dl>
            </div>
            <svg class="mtstamp" viewBox="0 0 100 100" aria-hidden="true">
              <defs><path id="mt-ring" d="M50 50 m-35 0 a35 35 0 1 1 70 0 a35 35 0 1 1 -70 0" /></defs>
              <circle cx="50" cy="50" r="46" class="mtstamp__line" />
              <circle cx="50" cy="50" r="27" class="mtstamp__line" />
              <text class="mtstamp__ring"><textPath href="#mt-ring" textLength="214" lengthAdjust="spacing">monkeytype · verified · monkeytype · verified ·</textPath></text>
              <text x="50" y="52" text-anchor="middle" class="mtstamp__n">{typing.best[0].wpm}</text>
              <text x="50" y="64" text-anchor="middle" class="mtstamp__u">wpm</text>
            </svg>
          </article>
        )}
        <div class="screenbox torn-top">
          <p class="boxhead">toolchain</p>
          <ul class="chain">
            {chain.proven.map(({ skill, mods }) => (
              <li><b class="mono">{skill.skill_name}</b><span class="mono">{mods.map((m) => m.part).join(' · ')}</span></li>
            ))}
          </ul>
          {chain.rest.length > 0 && <p class="mono small">also: {chain.rest.map((r) => r.skill.skill_name).join(' · ')}</p>}
        </div>
      </div>
    </Fragment>
  </Spread>

  <!-- 06-07 · subsystems & off hours | classifieds -->
  <Spread page={P.offHours} zine={Z} runL="off hours" runR="classifieds" id="offhours" label="Subsystems, off hours and classifieds" next={{ href: u('/projects/'), label: 'workbench' }}>
    <Fragment slot="left">
      <h2 class="hed hed--l hed--inverse">Subsystems</h2>
      <ul class="subs">
        {me.highlights.map((h) => (
          <li>
            <span class="subs__g mono" aria-hidden="true">{glyph(h.icon)}</span>
            <div><h3 class="hed hed--s">{h.title}</h3><p class="copy">{h.description}</p></div>
          </li>
        ))}
      </ul>
      {games.length > 0 && steam && (
        <div class="off">
          <p class="boxhead">off hours · <a href={steam.url} rel="noopener">{steam.handle}</a></p>
          <p class="note note--tilt off__note">research, obviously →</p>
          <div class="gtabs">
            <input type="radio" name="games" id="g-recent" class="sr-only" checked />
            {topGames.length > 0 && <input type="radio" name="games" id="g-top" class="sr-only" />}
            <div class="gtabs__bar" role="radiogroup" aria-label="Games list">
              <label for="g-recent">recently played</label>
              {topGames.length > 0 && <label for="g-top">most played</label>}
            </div>
            <ul class="games games--recent taped taped--top">
              {games.map((g) => (
                <li>
                  {g.img && <span class="games__img"><img src={g.img.src} width="92" height="35" alt="" loading="lazy" decoding="async" /></span>}
                  <span class="games__name">{g.name}</span>
                  <span class="mono">{g.hoursTotal} h</span>
                </li>
              ))}
            </ul>
            {topGames.length > 0 && (
              <ul class="games games--top taped taped--top">
                {topGames.map((g, i) => (
                  <li>
                    {g.img && <span class="games__img"><img src={g.img.src} width="92" height="35" alt="" loading="lazy" decoding="async" /></span>}
                    <span class="games__name"><span class="mono muted">{i + 1}.</span> {g.name}</span>
                    <span class="mono">{g.hoursTotal} h</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
          {reviews.length > 0 && (
            <ul class="reviews">
              {reviews.map((r) => (
                <li>
                  <span class:list={['lbl', !r.recommended && 'lbl--line']}>{r.recommended ? 'rec' : 'not rec'}</span>
                  <a href={r.url} rel="noopener">{r.name}</a>
                  <q>{r.text.length > 90 ? `${r.text.slice(0, 88)}…` : r.text}</q>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
    </Fragment>
    <Fragment slot="right">
      <div id="classifieds" class="stack">
        <p class="kicker">classifieds</p>
        <div class="ad">
          <p class="ad__head"><span class="ringed"><Ransom text="WANTED" /><Scribble kind="ring" /></span> <span class="note note--tilt">yes, you</span></p>
          <p class="copy">Collaborators, research ideas, internships, or just an interesting problem. Also teammates for whatever game you're on; send an invite and I'll hop in.</p>
          <a class="btn btn--hot" href={u('/contact/')}>write to me</a>
        </div>
        <div class="ad ad--ports">
          <p class="ad__head ad__head--s">I/O · ports</p>
          <ul class="ports">
            {ports.map((p) => <li><span class="lbl">{p.k}</span><a href={p.href} rel={p.href.startsWith('http') ? 'me noopener' : undefined}>{p.v}</a></li>)}
          </ul>
        </div>
        <div class="coupon">
          <span class="coupon__cut" aria-hidden="true">✂</span>
          <p><b class="hed hed--s">resume.pdf</b> <span class="mono muted">· one page · no postage</span></p>
          <a class="btn" href={u('/resume.pdf')}>download</a>
        </div>
      </div>
    </Fragment>
  </Spread>
</Base>

<style>
  /* cover ---------------------------------------------------------------- */
  :global(.page--cover) { background: var(--cover) !important; color: var(--on-cover); padding: 26px 26px 26px 44px !important; }
  .cover { position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: 14px; min-height: 100%; flex: 1; }
  .spine {
    position: absolute; left: -32px; top: 0; bottom: 0;
    writing-mode: vertical-rl; rotate: 180deg; text-align: right;
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.24em; text-transform: uppercase;
  }
  .mast { display: grid; justify-items: start; gap: 2px; }
  .mast__small {
    padding: 0.1rem 0.5rem; background: var(--paper); color: var(--ink); border: 2px solid var(--ink);
    font-family: var(--font-mono); font-weight: 700; font-size: clamp(1.4rem, calc(var(--pw) * 0.07), 2.4rem); letter-spacing: 0.02em; text-transform: uppercase; line-height: 1.1;
  }
  .mast__big {
    font-family: var(--font-sans); font-weight: 900; font-stretch: 125%; text-transform: uppercase;
