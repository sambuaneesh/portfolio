---
import Base from '../layouts/Base.astro';
import Spread from '../components/Spread.astro';
import { getPersonalInfo, getExperience, getEducation, getAchievements, getSkills, getCourses, getLanguages, getModules, getBlogPosts, getSiteSettings } from '../lib/db';
import { u } from '../lib/site';
import { localeOf } from '../lib/toolchain';
import { pageMap, pad2 } from '../lib/zine';

const [me, experience, education, achievements, skills, courses, languages, modules, posts, settings] = await Promise.all([
  getPersonalInfo(), getExperience(), getEducation(), getAchievements(), getSkills(), getCourses(), getLanguages(), getModules(), getBlogPosts(), getSiteSettings(),
]);
const P = pageMap(modules, posts.length);
const Z = settings.zine_title;
const lastProject = modules[modules.length - 1];

const skillGroups = [...skills.reduce((map, s) => {
  map.set(s.category, [...(map.get(s.category) ?? []), s]);
  return map;
}, new Map<string, typeof skills>())];
const sortedCourses = [...courses].sort((a, b) => Number(!!b.is_favorite) - Number(!!a.is_favorite));
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').split('/')[0];
const prevHref = lastProject ? u(`/projects/${lastProject.slug}/`) : u('/projects/');
---
<Base title="CV" crumb="field log" ws="cv" description={`Experience, education, research, skills and coursework of ${me.name}.`} prevHref={prevHref} nextHref={u('/writing/')}>
  <Spread page={P.log} zine={Z} runL="field log" runR="field log · education" label="CV: experience and education"
    prev={{ href: prevHref, label: 'workbench' }}>
    <Fragment slot="left">
      <p class="kicker">field log · cv</p>
      <h1 class="hed hed--xl hed--cond">{me.name}</h1>
      <p class="mono contact">{[me.location, me.email].filter(Boolean).join('  ·  ')}</p>
      <div class="btns no-print">
        <a class="btn btn--hot" href={u('/resume.pdf')} download>download pdf</a>
        <button class="btn" type="button" data-print>print</button>
      </div>
      <h2 class="boxhead" id="experience">experience</h2>
      <ol class="log">
        {experience.map((e) => (
          <li>
            <p class="mono when">{e.duration}</p>
            <h3 class="hed hed--s">{e.title}</h3>
            <p class="mono where">{e.company}{e.location ? ` · ${e.location}` : ''}</p>
            {e.description?.length ? <ul class="copy bullets">{e.description.map((d) => <li>{d}</li>)}</ul> : null}
            {e.technologies?.length ? <ul class="tags">{e.technologies.map((t) => <li>{t}</li>)}</ul> : null}
          </li>
        ))}
      </ol>
    </Fragment>
    <Fragment slot="right">
      <h2 class="hed hed--l hed--inverse" id="education">Education</h2>
      <ul class="edu">
        {education.map((ed) => (
          <li>
            <h3 class="hed hed--s">{ed.institution}</h3>
            <p class="copy">{ed.degree}</p>
            <dl class="spec">
              <div><dt>term</dt><dd>{ed.duration}</dd></div>
              {ed.gpa && <div><dt>score</dt><dd>{ed.gpa.replace(/^CGPA:\s*/i, '')}</dd></div>}
              {ed.location && <div><dt>loc</dt><dd>{ed.location}</dd></div>}
            </dl>
            {ed.description && <p class="copy muted">{ed.description}</p>}
          </li>
        ))}
      </ul>
      <div class="rulebox term" id="languages">
        <p class="mono muted">$ locale -a</p>
        <ul class="locales mono">
          {languages.map((l) => <li><span>{localeOf(l.name)}</span><span><b>{l.name}</b> <span class="muted"># {l.level.toLowerCase()}</span></span></li>)}
        </ul>
      </div>
    </Fragment>
  </Spread>

  <Spread page={P.log + 2} zine={Z} runL="field log · record" runR="field log · coursework" label="CV: research, skills and coursework"
    next={{ href: u('/writing/'), label: 'writing' }}>
    <Fragment slot="left">
      <h2 class="hed hed--l hed--outline" id="record">Research &amp; awards</h2>
      <ol class="awards">
        {achievements.map((a, i) => (
          <li>
            <span class="lbl">{pad2(i + 1)}</span>
            <div>
              <h3 class="hed hed--s">{a.certificate_url ? <a href={a.certificate_url} rel="noopener">{a.title}</a> : a.title}</h3>
              {a.description && <p class="copy">{a.description}</p>}
              <p class="mono muted small">{[a.date_achieved, a.certificate_url && host(a.certificate_url)].filter(Boolean).join(' · ')}</p>
            </div>
          </li>
        ))}
      </ol>
      <h2 class="boxhead" id="skills">skills</h2>
      <div class="skills">
        {skillGroups.map(([cat, list]) => (
          <section>
            <h3 class="kicker">{cat}</h3>
            <ul class="keycaps">{list.map((s) => <li><kbd class="k">{s.skill_name}</kbd></li>)}</ul>
          </section>
        ))}
      </div>
    </Fragment>
    <Fragment slot="right">
      <h2 class="hed hed--l hed--wide fit-line" id="courses">Coursework</h2>
      <table class="courses">
        <thead><tr><th scope="col">course</th><th scope="col">term</th></tr></thead>
        <tbody>
          {sortedCourses.map((c) => (
            <tr class:list={{ fav: c.is_favorite }}>
              <td>{c.certificate_url ? <a href={c.certificate_url}>{c.name}</a> : c.name}</td>
              <td class="mono">{/^\d{4}-\d{2}-\d{2}$/.test(c.completion_date ?? '') ? c.completion_date!.slice(0, 4) : c.completion_date}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </Fragment>
  </Spread>
</Base>

<script>
  document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => print()));
</script>

<style>
  .contact { font-size: 0.72rem; color: var(--muted); }
  .log { list-style: none; display: grid; gap: 14px; }
  .log > li { display: grid; gap: 4px; padding-left: 12px; border-left: 4px solid var(--ink); }
  .when { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .where { font-size: 0.74rem; }
  .bullets { padding-left: 1.1em; display: grid; gap: 2px; font-size: 0.88rem; }
  .edu { list-style: none; display: grid; gap: 16px; }
  .edu > li { display: grid; gap: 6px; }
  .edu > li + li { padding-top: 14px; border-top: 2px dotted var(--ink); }
  .term { display: grid; gap: 8px; font-size: 0.78rem; }
  .locales { list-style: none; display: grid; gap: 4px; }
  .locales li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 1rem; }
  .awards { list-style: none; display: grid; gap: 12px; }
  .awards li { display: grid; grid-template-columns: auto 1fr; gap: 10px; align-items: start; }
  .awards .copy { font-size: 0.88rem; margin-top: 2px; }
  .small { font-size: 0.68rem; margin-top: 2px; }
  .skills { display: grid; gap: 12px; }
  .skills .kicker { margin-bottom: 6px; }
  .keycaps { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .keycaps .k { font-size: 0.8rem; padding: 0.15rem 0.5rem; }
  .courses { width: 100%; border-collapse: collapse; font-family: var(--font-serif); font-size: 0.88rem; }
  .courses th { text-align: left; font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 2px solid var(--ink); padding: 4px 6px; }
  .courses td { padding: 4px 6px; border-bottom: 1px dotted var(--ink); }
  .courses td:last-child { white-space: nowrap; font-size: 0.74rem; }
  .courses tr.fav td:first-child { font-weight: 700; }
</style>
