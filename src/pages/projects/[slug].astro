---
import Base from '../../layouts/Base.astro';
import Spread from '../../components/Spread.astro';
import { getModules, getBlogPosts, getSiteSettings, type Module } from '../../lib/db';
import { u, fmtDate } from '../../lib/site';
import { optimize } from '../../lib/images';
import { getReadme } from '../../lib/readme';
import { renderMarkdown } from '../../lib/markdown';
import { pageMap } from '../../lib/zine';
import { around } from '../../lib/order';

export async function getStaticPaths() {
  const modules = await getModules();
  return modules.map((m, i) => ({
    params: { slug: m.slug },
    props: { m, i, prev: modules[i - 1] ?? null, next: modules[i + 1] ?? null },
  }));
}

interface Props { m: Module; i: number; prev: Module | null; next: Module | null }
const { m, i, prev, next } = Astro.props;
const [modules, posts, settings] = await Promise.all([getModules(), getBlogPosts(), getSiteSettings()]);
const P = pageMap(modules, posts.length);

const shots = [...new Set([m.image_url, ...(m.images ?? [])].filter(Boolean) as string[])];
const screens = await Promise.all(shots.map(async (src) => ({ ...(await optimize(src, 1100)), orig: src })));
const ogImage = screens[0] ? new URL(screens[0].src, Astro.site).href : undefined;

// The write-up: a manual one from /admin wins; otherwise the repo README,
// unless it's been switched off for this project.
let readme: { html: string; file: string; href: string | null } | null = null;
const opts = settings.project_extras?.[m.id] ?? {};
if (opts.readme_override?.trim()) {
  readme = { html: await renderMarkdown(opts.readme_override, { demote: 1 }), file: 'notes', href: null };
} else if (opts.show_readme !== false && m.repo) {
  const r = await getReadme(m.repo.owner, m.repo.name);
  if (r) readme = { html: await renderMarkdown(r.markdown, { baseHref: r.baseHref, baseSrc: r.baseSrc, demote: 1 }), file: r.file, href: `${r.baseHref}${r.file}` };
}

// every article gets its own headline voice, like a real zine
const voices = ['hed--wide', 'hed--cond', 'hed--outline', 'hed--inverse'];
const voice = voices[i % voices.length];
// long names step down a size instead of breaking mid-word
const longest = Math.max(...m.title.split(/\s+/).map((w) => w.length));
// the wide voice takes ~40% more room per letter
const room = voice === 'hed--wide' ? longest * 1.4 : longest;
const size = room <= 7 ? 'hed--xl' : room <= 11 ? 'hed--l' : 'hed--m';

const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const spec: [string, string | null][] = [
  ['part', m.part],
  ['language', m.language],
  ['type', m.is_contributed ? 'team project' : 'solo'],
  ['category', m.category],
  ['stars', m.stars != null ? `★ ${m.stars}` : null],
  ['forks', m.forks != null ? String(m.forks) : null],
  ['license', m.license],
  ['last push', m.pushedAt ? fmtDate(m.pushedAt) : null],
];
const stops = around(modules, u(`/projects/${m.slug}/`));
const prevHref = stops.prev!.href;
const nextHref = stops.next!.href;
---
<Base title={m.title} ws="projects" description={m.description} image={ogImage} prevHref={prevHref} nextHref={nextHref}>
  <Spread fixed page={P.projects[m.slug]} zine={settings.zine_title} runL={`${m.vibe ? 'vibe coded' : 'workbench'} · ${m.part}`} runR={m.title} label={m.title}
    prev={{ href: prevHref, label: stops.prev!.label }}
    next={{ href: nextHref, label: stops.next!.label }}>
    <Fragment slot="left">
      <p class="kicker">{m.vibe ? 'supplement · vibe coded' : 'workbench'} · {m.part}</p>
      <h1 class:list={['hed', size, voice, 'proj-title']}>{m.title}</h1>
      <p class="copy dropcap">{m.description}</p>
      {m.tags?.length ? <ul class="tags" aria-label="Tags">{m.tags.map((t) => <li>{t}</li>)}</ul> : null}
      <div class="btns">
        <span class="stamp punk-only push-stamp" aria-hidden="true">{m.vibe ? 'vibe coded' : m.pushedAt ? `last push ${new Date(m.pushedAt).getFullYear()}` : m.github_url ? 'source on github' : 'unreleased'}</span>
        {m.github_url && <a class="btn btn--hot" href={m.github_url} rel="noopener">source</a>}
        {m.live_url && <a class="btn" href={m.live_url} rel="noopener">live</a>}
      </div>
      <div class="rulebox">
        <dl class="spec">
          {spec.filter(([, v]) => v).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          {m.repo && <div><dt>repo</dt><dd><a href={m.github_url!} rel="noopener">{m.repo.owner}/{m.repo.name}</a></dd></div>}
          {m.live_url && <div><dt>live</dt><dd><a href={m.live_url} rel="noopener">{host(m.live_url)}</a></dd></div>}
        </dl>
      </div>
      {screens[0] && (
        <figure class="fig fig--main taped">
          <a class="shot halftone" href={screens[0].orig}><img src={screens[0].src} width={screens[0].width} height={screens[0].height} alt={`${m.title} screenshot`} decoding="async" /></a>
          <figcaption class="mono">fig. 1 · {m.title}{screens.length > 1 ? ` · +${screens.length - 1} more` : ''}</figcaption>
        </figure>
      )}
      {screens.length > 1 && (
        <ul class="thumbs">
          {screens.slice(1).map((s, n) => (
            <li><a class="shot halftone" href={s.orig}><img src={s.src} width={s.width} height={s.height} alt={`${m.title} screenshot ${n + 2}`} loading="lazy" decoding="async" /></a></li>
          ))}
        </ul>
      )}
    </Fragment>
    <Fragment slot="right">
      {readme ? (
        <article class="readme">
          <p class="boxhead">{readme.file === 'notes' ? 'notes' : readme.file}</p>
          <div class="readme__clip" data-clip><div class="prose" set:html={readme.html} /></div>
          {readme.href && <p class="readme__more mono"><a href={readme.href} rel="noopener"><span data-cut-only>… </span>continued on github</a></p>}
        </article>
      ) : (
        <p class="copy muted">No write-up for this one yet.</p>
      )}
    </Fragment>
  </Spread>
</Base>

<script>
  // Fade + "…" only when the README really overflows its page.
  const mark = () => document.querySelectorAll<HTMLElement>('[data-clip]').forEach((el) => {
    el.classList.toggle('is-cut', el.scrollHeight > el.clientHeight + 4);
  });
  mark();
  addEventListener('load', mark, { once: true });
  addEventListener('resize', mark, { passive: true });
</script>

<style>
  .proj-title { overflow-wrap: normal; word-break: normal; hyphens: none; }
  .push-stamp { order: 3; margin-left: auto; align-self: center; }
  .fig { margin: 0; display: grid; gap: 4px; }
  .fig a { display: block; border: 1.5px solid var(--ink); }
  .fig img { width: 100%; height: auto; }
  .fig figcaption { font-size: 0.68rem; color: var(--muted); }
  /* the main screenshot takes whatever is left of the page */
  .fig--main { flex: 1 1 auto; min-height: 0; grid-template-rows: minmax(0, 1fr) auto; }
  .fig--main a { min-height: 0; overflow: hidden; background: var(--paper-2); }
  .fig--main img { height: 100%; object-fit: cover; object-position: top; }
  .thumbs { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr)); gap: 6px; }
  .thumbs a { display: block; border: 1.5px solid var(--ink); aspect-ratio: 16 / 10; overflow: hidden; }
  .thumbs img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .readme { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  /* one page of README, then it's cut off and continues on GitHub */
  .readme__clip { position: relative; flex: 1 1 auto; min-height: 0; max-height: 150svh; overflow: hidden; }
  @media (min-width: 62rem) { .readme__clip { max-height: none; } }
  .readme__clip.is-cut::after {
    content: ''; position: absolute; inset: auto 0 0 0; height: 7rem; pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--paper) 85%);
  }
  .readme__more { font-size: 0.74rem; font-weight: 700; text-align: right; }
  .readme__more a::after { content: ' ▸▸▸'; letter-spacing: -0.1em; }
  [data-cut-only] { display: none; }
  .readme:has(.is-cut) [data-cut-only] { display: inline; }
  .readme .prose { font-size: 0.9rem; }
  .readme .prose :global(h2:first-child) { margin-top: 0; }
  .readme .prose :global(img) { display: inline-block; vertical-align: middle; }
  .readme .prose :global(p > img:only-child), .readme .prose :global(p > a:only-child > img) { display: block; border: 1.5px solid var(--ink); }
  .src { font-size: 0.72rem; }
</style>
