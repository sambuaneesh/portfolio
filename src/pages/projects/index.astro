---
import Base from '../../layouts/Base.astro';
import Spread from '../../components/Spread.astro';
import Entry from '../../components/Entry.astro';
import { getModules, getBlogPosts, getSiteSettings, slugify } from '../../lib/db';
import { u } from '../../lib/site';
import { pageMap } from '../../lib/zine';

const [all, posts, settings] = await Promise.all([getModules(), getBlogPosts(), getSiteSettings()]);
const P = pageMap(all, posts.length);
const modules = all.filter((m) => !m.vibe);
const langs = [...new Map(modules.filter((m) => m.language).map((m) => [m.language!, m.language_color])).entries()];
const half = Math.ceil(modules.length / 2);
const first = modules[0];

// Filtering is pure CSS: a radio per language + :has(). Zero JS.
const filterCss = langs
  .map(([l]) => `.catalog:has(#f-${slugify(l)}:checked) .entry:not([data-lang="${slugify(l)}"]){display:none}`)
  .join('\n');
---
<Base title="Projects" crumb="catalogue" ws="projects" description={`${modules.length} projects by Aneesh Sambu: shells, file systems, interpreters, distributed systems and tools.`} prevHref={u('/')} nextHref={first ? u(`/projects/${first.slug}/`) : undefined}>
  <div class="catalog">
    <Spread page={P.workbench} zine={settings.zine_title} runL="workbench" runR="the catalogue" label="Project catalogue"
      prev={{ href: u('/#offhours'), label: 'back' }} next={first ? { href: u(`/projects/${first.slug}/`), label: first.title } : null}>
      <Fragment slot="left">
        <p class="kicker">workbench</p>
        <h1 class="hed hed--l hed--wide one-line">The catalogue</h1>
        <fieldset class="filters">
          <legend class="lbl">language</legend>
          <label><input type="radio" name="lang" id="f-all" checked /><span>all</span></label>
          {langs.map(([l]) => <label><input type="radio" name="lang" id={`f-${slugify(l)}`} /><span>{l}</span></label>)}
        </fieldset>
        <div class="list">{modules.slice(0, half).map((m) => <Entry m={m} page={P.projects[m.slug]} />)}</div>
      </Fragment>
      <Fragment slot="right">
        <div class="list">{modules.slice(half).map((m) => <Entry m={m} page={P.projects[m.slug]} />)}</div>
      </Fragment>
    </Spread>
  </div>
  <style set:html={filterCss}></style>
</Base>

<style>
  .list { display: grid; gap: 12px; }
  .one-line { white-space: nowrap; font-size: clamp(1.3rem, calc(var(--pw) * 0.064), 2.8rem); }
  .filters { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .filters legend { float: left; margin-right: 6px; }
  .filters label { cursor: pointer; }
  .filters input { position: absolute; opacity: 0; pointer-events: none; }
  .filters label > span { display: inline-block; padding: 0.15rem 0.55rem; border: 1.5px solid var(--ink); font-family: var(--font-mono); font-size: 0.74rem; }
  .filters input:checked + span { background: var(--black); color: var(--on-black); }
  .filters input:focus-visible + span { outline: 3px solid var(--ink); outline-offset: 2px; }
</style>
