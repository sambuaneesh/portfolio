---
import Base from '../layouts/Base.astro';
import Spread from '../components/Spread.astro';
import Ransom from '../components/Ransom.astro';
import { u } from '../lib/site';
import { getModules, getSiteSettings } from '../lib/db';

const [modules, settings] = await Promise.all([getModules(), getSiteSettings()]);
---
<Base title="Page missing" noindex>
  <Spread page={0} single zine={settings.zine_title} runL="page ??" label="Missing page">
    <div class="torn">
      <p class="kicker">errata</p>
      <h1 class="hed hed--xl"><Ransom text="Page missing" /></h1>
      <p class="copy dropcap">Do you like broken links? Somebody tore this page out of the zine: <code class="mono" data-path>?</code> isn't in this issue. I checked.</p>
      <div class="btns">
        <a class="btn btn--hot" href={u('/')}>cover</a>
        <a class="btn" href={u('/#contents')}>contents</a>
        <a class="btn" href={u('/projects/')}>workbench</a>
      </div>
      <p class="mono muted small">or one of: {modules.map((m, i) => <>{i > 0 && ' · '}<a href={u(`/projects/${m.slug}/`)}>{m.slug}</a></>)}</p>
    </div>
  </Spread>
</Base>

<script>
  const el = document.querySelector('[data-path]');
  if (el) el.textContent = location.pathname.replace(/^\/portfolio/, '') || '/';
</script>

<style>
  .torn { display: flex; flex-direction: column; gap: 18px; }
  .small { font-size: 0.72rem; line-height: 1.7; }
  /* the page itself is ripped along the bottom */
  :global(.spread--single .page) {
    clip-path: polygon(0 0, 100% 0, 100% 93%, 96% 95%, 91% 92.5%, 86% 96%, 80% 93%, 74% 96.5%, 67% 93.5%, 61% 96%, 54% 92.8%, 48% 96.2%, 41% 93.2%, 35% 96.5%, 28% 93%, 22% 95.8%, 15% 92.6%, 9% 95.5%, 4% 93%, 0 95%);
  }
  :global(.spread--single .folio) { display: none; }
</style>
