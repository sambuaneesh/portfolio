# Supabase (public, RLS-protected). Used at build time to bake content into HTML,
# and in the browser for contact forms, likes and comments.
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional: raises the GitHub API rate limit when enriching projects at build time.
# GITHUB_TOKEN=

# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey) for the
# full game library in "off hours". Build-time only; never reaches the browser.
# STEAM_API_KEY=
